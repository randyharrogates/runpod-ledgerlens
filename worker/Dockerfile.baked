# Shared steps must stay in step with worker/Dockerfile.
# A self-contained handler and model: no network volume or data-centre pinning.
# Trade-off: about 16 GiB more; slower builds/pulls. Cold start to be measured.
# Runpod GitHub builder limits: 30-minute build, 80 GB image.
# vLLM's official image. cu129 (CUDA 12.9) rather than the CUDA 13 default, so it runs on more
# Runpod hosts' drivers. Qwen3-VL needs vLLM >= 0.11.
ARG VLLM_IMAGE=vllm/vllm-openai:v0.31.0-cu129
FROM ${VLLM_IMAGE}

# The base image's entrypoint starts the vLLM server; our handler starts it instead.
ENTRYPOINT []
WORKDIR /app

# Pin everything already installed, so adding runpod/httpx can never upgrade a package vLLM
# depends on. If they conflict, the build fails here instead of the worker failing later.
RUN pip list --format=freeze > /tmp/constraints.txt \
 && pip install --no-cache-dir -c /tmp/constraints.txt runpod==1.10.0 httpx
# The cu129 image ships a CUDA 13 torchcodec (needs libcudart.so.13), which raises OSError when vLLM
# imports it and kills the server at start. We only send images, so remove it; vLLM treats a missing
# torchcodec as "no audio decoding". The import check fails the build, not the worker, if this recurs.
RUN pip uninstall -y torchcodec \
 && python3 -c "import vllm.multimodal.media"
ARG MODEL_ID=Qwen/Qwen3-VL-8B-Instruct
ARG MODEL_REVISION=0c351dd01ed87e9c1b53cbc748cba10e6187ff3b
RUN python3 -c "from huggingface_hub import snapshot_download; snapshot_download(repo_id='${MODEL_ID}', revision='${MODEL_REVISION}', local_dir='/models/model')" \
 && rm -rf /root/.cache/huggingface
ENV MODEL_PATH=/models/model HF_HUB_OFFLINE=1

COPY pyproject.toml /app/pyproject.toml
COPY src/ledgerlens /app/src/ledgerlens
RUN pip install --no-cache-dir --no-deps /app
COPY worker /app/worker

CMD ["python3", "-u", "/app/worker/handler.py"]
